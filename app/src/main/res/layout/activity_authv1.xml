<?xml version="1.0" encoding="utf-8"?>
<!--
     Date :
     Membre qui travaille dessus : Yasmine DEHOUCHE.
     Que fait le code XML? Ce layout XML représente la page d'accueil de l'application, elle inclue:
        -Le bouton connexion afin que l'utilisateur puisse avoir accès à son compte Mimichi en entrant son adresse e-mail et son mot de passe.
        -Le bouton inscription pour créer un nouveau compte.
        -Le bouton mot de passe oublié pour réinitialiser le mot de passe.
-->


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#debdf0"
    tools:context=".AuthActivity">


    <ImageView
        android:id="@+id/imageViewBienvenue"
        android:layout_width="344dp"
        android:layout_height="324dp"
        android:contentDescription="@string/image_de_bienvenue"
        android:src="@drawable/bienvenue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.289" />

    <TextView
        android:layout_width="399dp"
        android:layout_height="102dp"
        android:gravity="center"
        android:text="@string/nouveau_ou_ancien_ton_mimichi_est_toujours_l_pour_toi"
        android:textSize="30sp"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.041"
        tools:ignore="VisualLintOverlap,TextSizeCheck" />

    <Button
        android:id="@+id/connexionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:onClick="connexion"
        android:text="@string/connexion"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.452"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="TextSizeCheck"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/editTextNumberPassword"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:background="@drawable/textviewbg"
        android:ems="10"
        android:hint="@string/entrez_votre_mot_de_passe"
        android:inputType="textPassword"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.463"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.772"
        tools:ignore="Autofill,TextFields" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:background="@drawable/textviewbg"
        android:ems="10"
        android:hint="@string/entrez_votre_adresse_e_mail"
        android:inputType="textEmailAddress"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.627"
        tools:ignore="Autofill" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adresse e-mail"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.296"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.571"
        tools:ignore="HardcodedText,TextSizeCheck,VisualLintOverlap" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mot_de_passe"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.296"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.71"
        tools:ignore="TextSizeCheck" />


    <TextView
        android:id="@+id/tv_forgot_password"
        android:layout_width="171dp"
        android:layout_height="48dp"
        android:layout_marginBottom="60dp"
        android:onClick="load_recuperationMdpActivity"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/mot_de_passe_oubli"
        android:textColor="#1565C0"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_signup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextNumberPassword"
        tools:ignore="TextSizeCheck" />

    <TextView
        android:id="@+id/tv_signup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:onClick="load_inscription_activity"
        android:text="@string/pr_t_adopter_ton_nouveau_compagnon_inscris_toi_ici"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_forgot_password"
        app:layout_constraintVertical_bias="0.789"
        tools:ignore="OnClick" />


</androidx.constraintlayout.widget.ConstraintLayout>